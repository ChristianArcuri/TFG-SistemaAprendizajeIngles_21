# ===== App =====
APP_ENV=development
APP_NAME=tfg-sai

# ===== HTTP =====
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=15s
# Origenes del frontend (Vite). Coma-separados.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== PostgreSQL =====
# Usado por la API (host="postgres" cuando corre en docker-compose).
DATABASE_URL=postgres://remotetalk:remotetalk@postgres:5432/remotetalk?sslmode=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s

# Usado por el servicio de Postgres en docker-compose.
POSTGRES_USER=remotetalk
POSTGRES_PASSWORD=remotetalk
POSTGRES_DB=remotetalk

# ===== JWT =====
# En produccion debe tener al menos 32 caracteres.
JWT_SECRET=change-me-please-change-me-please-32+chars
JWT_EXPIRES_IN=24h

# ===== AI =====
# AI_PROVIDER controla la implementacion de feedback y transcripcion:
#   mock   -> coach simulado (default, no llama a OpenAI)
#   openai -> Whisper + Chat Completions (requiere OPENAI_API_KEY)
AI_PROVIDER=mock
# Tamano maximo del audio aceptado en POST /api/v1/practice/analyze-audio (bytes).
# Default: 15 MB.
MAX_AUDIO_BYTES=15728640

# ===== OpenAI (requerido si AI_PROVIDER=openai) =====
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_FEEDBACK_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_TIMEOUT=60s
OPENAI_FEEDBACK_TIMEOUT=30s

# Con AI_PROVIDER=openai, subi HTTP_WRITE_TIMEOUT para cubrir transcripcion + feedback:
# HTTP_WRITE_TIMEOUT=90s
